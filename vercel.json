{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "/data/schedule\\.bin", "dest": "/api/schedule" },
    { "src": "/api/schedule", "dest": "/api/schedule" },
    { "src": "/api/v1/schedule", "dest": "/api/schedule" },
    { "src": "/schedule_cache\\.json", "dest": "/api/schedule" },
    { "src": "/cdn-img", "dest": "/api/cdn-img" },
    { "src": "/terms-of-service/?", "dest": "/terms-of-service.html" },
    { "src": "/privacy-policy/?", "dest": "/privacy-policy.html" },
    { "src": "/dmca/?", "dest": "/dmca.html" },
    { "src": "/contact/?", "dest": "/contact.html" },
    { "src": "/watch/(.*)", "dest": "/watch.html" },
    { "src": "/play/(.*)", "dest": "/play.html" },
    { "handle": "filesystem" }
  ],
  "headers": [
    {
      "source": "/(data/schedule\\.bin|api/.*|schedule_cache\\.json)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Cloudflare-CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)\\.(html|htm)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
